{
  "expo": {
    "name": "BarbellFitness",
    "slug": "BarbellFitness",
    "scheme": "BarbellFitnessScheme",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.BarbellFitness",
      "compileSdkVersion": 34
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37a47d2a-58bf-46e2-aeb9-2341ab25da0f"
      }
    }
  }
}
