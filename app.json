{
  "expo": {
    "name": "BarbellFitness",
    "slug": "barbellfitness",
    "scheme": "barbellfitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.BarbellFitness",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-build-properties",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow BarbellFitness to use your camera for your profile photo.",
          "photosPermission": "Allow BarbellFitness to access photos you choose for your profile."
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37a47d2a-58bf-46e2-aeb9-2341ab25da0f"
      }
    }
  }
}
