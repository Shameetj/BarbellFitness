rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has an 'admin' or 'owner' role in Firestore
    function isAdminOrOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner');
    }

    // Validate that a member creating their own profile cannot grant themselves admin/owner roles
    function isValidMemberCreate() {
      return !('role' in request.resource.data) || request.resource.data.role == 'member';
    }

    // Validate that a member updating their own profile preserves their existing role and cannot escalate privileges
    function isValidMemberUpdate() {
      return (!('role' in resource.data) && (!('role' in request.resource.data) || request.resource.data.role == 'member')) ||
             ('role' in resource.data && request.resource.data.role == resource.data.role);
    }

    // Rules for user profiles
    match /users/{userId} {
      // Normal authenticated members can only read their own profile; admins/owners can read all
      allow read: if isOwner(userId) || isAdminOrOwner();

      // Normal members can create their profile without role escalation; admins/owners can create any profile
      allow create: if (isOwner(userId) && isValidMemberCreate()) || isAdminOrOwner();

      // Normal members can update their profile while preserving role; admins/owners can update any profile and manage roles
      allow update: if (isOwner(userId) && isValidMemberUpdate()) || isAdminOrOwner();

      // Only admins/owners can delete user profiles
      allow delete: if isAdminOrOwner();

      // Rules for membership subcollection
      match /membership/{membershipId} {
        // Authenticated member can read ONLY their own membership; admins/owners can read all
        allow read: if isOwner(userId) || isAdminOrOwner();

        // ONLY admin/owner can create, update, or delete membership records
        allow create, update, delete: if isAdminOrOwner();
      }

      // Rules for personal records (PRs) subcollection
      match /prs/{prId} {
        // Authenticated member can read ONLY their own PRs; admins/owners can read all
        allow read: if isOwner(userId) || isAdminOrOwner();

        // Members can log, update, or delete their own PRs; admins/owners can manage any member's PRs
        allow create, update, delete: if isOwner(userId) || isAdminOrOwner();
      }

      // Rules for attendance subcollection
      match /attendance/{attendanceId} {
        // Authenticated member can read ONLY their own attendance; admins/owners can read all
        allow read: if isOwner(userId) || isAdminOrOwner();

        // ONLY admin/owner can create, update, or delete attendance records
        allow create, update, delete: if isAdminOrOwner();
      }

      // Rules for workouts subcollection
      match /workouts/{workoutId} {
        // Authenticated member can read ONLY their own workouts; admins/owners can read all
        allow read: if isOwner(userId) || isAdminOrOwner();

        // Members can create, update, and delete their own workouts; admins/owners have full control
        allow create, update, delete: if isOwner(userId) || isAdminOrOwner();
      }
    }

    // Rules for gym announcements
    match /announcements/{announcementId} {
      // Authenticated users can read announcements
      allow read: if isAuthenticated();

      // Only admins/owners can create, update, or delete announcements
      allow create, update, delete: if isAdminOrOwner();
    }

    // Rules for workout challenges
    match /challenges/{challengeId} {
      // Authenticated users can read challenges
      allow read: if isAuthenticated();

      // Only admins/owners can create, update, or delete challenges
      allow create, update, delete: if isAdminOrOwner();
    }

    // Helper to validate allowed membership plan names
    function isValidPlan(plan) {
      return plan in ['Basic', 'Standard', 'Wellness', 'Platinum'];
    }

    // Helper to validate allowed request types
    function isValidRequestType(reqType) {
      return reqType in ['new', 'renewal'];
    }

    // Validate member creating a membership request
    function isValidMemberRequestCreate() {
      return isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        isValidPlan(request.resource.data.plan) &&
        (!('requestType' in request.resource.data) || isValidRequestType(request.resource.data.requestType)) &&
        !('reviewedBy' in request.resource.data) &&
        !('reviewedAt' in request.resource.data);
    }

    // Validate member cancelling their own pending membership request
    function isValidMemberRequestCancel() {
      return isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.requestedAt == resource.data.requestedAt &&
        ((!('requestType' in resource.data) && !('requestType' in request.resource.data)) ||
         ('requestType' in resource.data && 'requestType' in request.resource.data && request.resource.data.requestType == resource.data.requestType)) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        !('reviewedBy' in request.resource.data) &&
        !('reviewedAt' in request.resource.data);
    }

    // Validate admin/owner updating a membership request (approval or rejection)
    function isValidAdminRequestUpdate() {
      return isAdminOrOwner() &&
        resource.data.status == 'pending' &&
        (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected') &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.requestedAt == resource.data.requestedAt &&
        ((!('requestType' in resource.data) && !('requestType' in request.resource.data)) ||
         ('requestType' in resource.data && 'requestType' in request.resource.data && request.resource.data.requestType == resource.data.requestType)) &&
        request.resource.data.reviewedBy == request.auth.uid &&
        'reviewedAt' in request.resource.data &&
        request.resource.data.reviewedAt is string;
    }

    // Rules for membership requests
    match /membershipRequests/{requestId} {
      // Authenticated members can read their own requests; admins/owners can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdminOrOwner();

      // Members can create a valid pending request for themselves only; admins/owners can create
      allow create: if isValidMemberRequestCreate() || isAdminOrOwner();

      // Members can ONLY cancel their own pending request (preserving all other fields); admins/owners can only approve or reject pending requests with reviewedBy == request.auth.uid
      allow update: if isValidMemberRequestCancel() || isValidAdminRequestUpdate();

      // Only admins/owners can delete requests
      allow delete: if isAdminOrOwner();
    }
  }
}
